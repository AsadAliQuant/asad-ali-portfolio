---
import { Icon } from "astro-icon/components";
import { Card, CardContent, CardHeader, CardTitle } from "./ui/card";
import { Badge } from "./ui/badge";

const education = [
  {
    degree: "BS in Computer Science",
    school: "Virtual University of Pakistan",
    period: "Mar 2024 – Ongoing",
    ongoing: true,
    icon: "lucide:graduation-cap",
    detail: "CGPA 3.61/4.0",
  },
  {
    degree: "A Levels",
    school: "Cambridge Assessment International Education",
    period: "Nov 2021",
    icon: "lucide:book-open",
    detail: "Mathematics, Computer Science, Physics",
  },
  {
    degree: "O Levels",
    school: "Cambridge Assessment International Education",
    period: "Jun 2018",
    icon: "lucide:school",
    detail:
      "English Language, Urdu, Islamiyat, Pakistan Studies, Mathematics, Physics, Chemistry, Computer Science",
  },
];
---

<section id="credentials" class="px-6 py-section-lg">
  <div class="mx-auto flex max-w-[720px] flex-col gap-10">
    <h2 class="text-center text-heading-md text-ink">Credentials</h2>

    <Card className="border-hairline bg-brand-coral text-on-dark">
      <CardContent className="flex flex-col items-center gap-2 px-8 py-8 text-center">
        <Badge className="rounded-full bg-canvas text-caption-bold text-brand-coral">
          Achievement
        </Badge>
        <CardTitle className="font-heading text-card-title text-on-dark">
          NASA Astrobee Evaluation
        </CardTitle>
        <p class="text-body-sm text-on-dark/90">
          Selected globally by NASA for the Astrobee Challenge evaluation.
        </p>
      </CardContent>
    </Card>

    <Card className="border-hairline">
      <CardHeader>
        <CardTitle className="font-heading text-card-title text-ink">
          Education
        </CardTitle>
      </CardHeader>
      <CardContent>
        <ol class="flex flex-col">
          {
            education.map((item, i) => {
              const subjects = item.detail.includes(",")
                ? item.detail.split(", ")
                : null;
              return (
                <li class="relative flex gap-4 pb-7 last:pb-0">
                  {i < education.length - 1 && (
                    <span
                      aria-hidden="true"
                      class="absolute top-10 left-[19px] h-[calc(100%-2rem)] w-px bg-hairline"
                    />
                  )}
                  <span class="relative z-10 flex size-10 shrink-0 items-center justify-center rounded-full border border-hairline bg-surface text-ink">
                    <Icon name={item.icon} class="size-4.5" />
                  </span>
                  <div class="flex flex-1 flex-col gap-1.5 pt-1">
                    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                      <p class="text-body-sm-medium text-ink">
                        {item.degree}
                      </p>
                      <Badge
                        className={
                          item.ongoing
                            ? "border-transparent bg-brand-coral text-on-dark"
                            : "border-hairline bg-transparent text-stone"
                        }
                      >
                        {item.period}
                      </Badge>
                    </div>
                    <p class="text-body-sm text-steel">{item.school}</p>
                    {subjects ? (
                      <div class="mt-1 flex flex-wrap gap-1.5">
                        {subjects.map((subject) => (
                          <span class="rounded-full bg-surface px-2.5 py-1 text-caption text-charcoal">
                            {subject}
                          </span>
                        ))}
                      </div>
                    ) : (
                      <p class="text-caption text-stone">{item.detail}</p>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ol>
      </CardContent>
    </Card>
  </div>
</section>
