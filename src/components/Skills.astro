---
import { Badge } from "./ui/badge";

const skillGroups = [
  {
    category: "Frontend Development",
    skills: [
      "HTML & CSS",
      "JavaScript",
      "React",
      "React Native",
      "UX/UI Design",
      "Version Control",
    ],
  },
  {
    category: "Backend & Data",
    skills: [
      "Python",
      "SQL",
      "Databases",
      "Data Analysis",
      "Data Visualization",
      "Power BI",
      "Finance Analytics",
    ],
  },
  {
    category: "AI & Machine Learning",
    skills: [
      "Deep Learning",
      "Neural Networks (Keras/PyTorch/TensorFlow)",
      "Generative AI",
      "RAG",
      "Computer Vision",
    ],
  },
  {
    category: "Web & Mobile",
    skills: ["E-commerce", "LMS Development", "Android & iOS Apps"],
  },
];
---

<section id="skills" class="bg-surface px-6 py-section-lg">
  <div class="mx-auto flex max-w-[880px] flex-col gap-10">
    <h2 class="text-center text-heading-md text-ink">Skills</h2>

    <div class="flex flex-col gap-8">
      {
        skillGroups.map((group) => (
          <div class="flex flex-col gap-3">
            <h3 class="text-body-sm-medium text-steel uppercase tracking-wide">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <Badge
                  variant="outline"
                  className="h-auto rounded-full border-hairline bg-canvas px-5 py-2.5 text-body-sm-medium text-charcoal"
                >
                  {skill}
                </Badge>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
