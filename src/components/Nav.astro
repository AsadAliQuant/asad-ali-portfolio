---
import MobileNav from "./MobileNav.tsx";

const links = [
  { href: "#about", label: "About" },
  { href: "#credentials", label: "Credentials" },
  { href: "#certifications", label: "Certifications" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#experience", label: "Experience" },
];
---

<header
  class="sticky top-0 z-40 border-b border-hairline-soft bg-canvas/95 backdrop-blur"
>
  <div
    class="mx-auto flex h-16 max-w-[1280px] items-center justify-between gap-6 px-6"
  >
    <a href="#" class="text-card-title text-ink">Asad Ali</a>

    <nav class="hidden items-center gap-8 lg:flex">
      {
        links.map((link) => (
          <a href={link.href} class="text-body-sm-medium text-charcoal">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href="#contact"
        class="rounded-full bg-primary px-6 py-[11px] text-button-md text-primary-foreground"
      >
        Get in Touch
      </a>
    </div>

    <div class="lg:hidden">
      <MobileNav client:load />
    </div>
  </div>
</header>
