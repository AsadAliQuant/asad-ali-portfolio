---

<section id="certifications" class="bg-surface px-6 py-section-lg">
  <div class="mx-auto flex max-w-[1280px] flex-col gap-10">
    <div class="flex flex-col items-center gap-4 text-center">
      <h2 class="text-heading-md text-ink">Certifications</h2>
      <p class="max-w-[560px] text-body-md text-steel">
        Courses and professional certifications completed across data
        science, AI, development, and business.
      </p>
      <a
        href="https://www.credly.com/users/asadinsights"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-ink px-5 py-2.5 text-button-md text-ink"
      >
        <Icon name="simple-icons:credly" class="size-4" />
        View badges on Credly
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        certifications.map((cert) => (
          <div class="flex flex-col gap-3 rounded-3xl border border-hairline bg-canvas p-6">
            <div class="flex flex-col gap-0.5">
              <p class="text-body-sm-medium text-ink">{cert.name}</p>
              <p class="text-caption text-stone">
                {cert.issuer}
                {cert.date ? ` · ${cert.date}` : ""}
              </p>
            </div>
            {cert.url && (
              <a
                href={cert.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-auto inline-flex items-center gap-1.5 text-body-sm-medium text-ink underline underline-offset-4"
              >
                View credential
                <Icon name="lucide:external-link" class="size-3.5" />
              </a>
            )}
          </div>
        ))
      }
    </div>

    {
      learningPaths.length > 0 && (
        <div class="flex flex-col gap-6">
          <h3 class="text-center text-body-sm-medium text-steel uppercase tracking-wide">
            Career Certificates
          </h3>
          <div class="mx-auto flex w-full max-w-[820px] flex-col gap-3">
            {learningPaths.map((path) => (
              <details class="group overflow-hidden rounded-3xl border border-hairline bg-canvas open:shadow-sm">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 select-none [&::-webkit-details-marker]:hidden">
                  <div class="flex flex-col gap-0.5">
                    <p class="text-body-sm-medium text-ink">{path.title}</p>
                    <p class="text-caption text-stone">
                      {path.provider} · {path.certs.length} courses
                      {path.date ? ` · ${path.date}` : ""}
                    </p>
                  </div>
                  <Icon
                    name="lucide:chevron-down"
                    class="size-5 shrink-0 text-steel transition-transform duration-300 group-open:rotate-180"
                  />
                </summary>
                <ul class="flex flex-col gap-1 border-t border-hairline px-4 pt-3 pb-4">
                  {path.certs.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-body-sm text-charcoal transition-colors hover:bg-surface hover:text-ink"
                      >
                        <span>{item.name}</span>
                        {item.url && (
                          <Icon
                            name="lucide:external-link"
                            class="size-3.5 shrink-0 text-stone"
                          />
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
